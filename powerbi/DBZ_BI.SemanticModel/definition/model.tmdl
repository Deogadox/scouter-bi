model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Servidor", "Banco", "dim_personagem", "dim_saga", "dim_transformacao", "dim_planeta", "fato_poder", "fato_luta"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_personagem
ref table dim_saga
ref table dim_transformacao
ref table dim_planeta
ref table fato_poder
ref table fato_luta
ref table 'Lutador A'
ref table 'Lutador B'
ref table _Paginas

ref cultureInfo pt-BR

