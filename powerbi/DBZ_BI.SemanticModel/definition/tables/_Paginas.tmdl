	/// Página Quiz: Quiz de 10 perguntas geradas a partir dos dados do modelo. HTML/CSS/JS minificados (fonte em powerbi/html).
	measure 'HTML Quiz' =
			VAR dados = [JSON Dados]
			RETURN
			    "<style>@import url(https://fonts.googleapis.com/css2?family=Bangers&family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700;800;900&display=swap);:root{--bg:#070b16;--card:rgba(16, 23, 42, .82);--card2:rgba(25, 34, 60, .9);--line:rgba(148, 163, 209, .12);--line2:rgba(148, 163, 209, .24);--txt:#eef2fa;--sub:#9aa6c4;--mut:#5f6b8a;--or:#ff8a00;--or2:#ffc21a;--gr:#39ff88;--bl:#3b82f6;--bl2:#60a5fa;--rd:#ff4d5e;--pk:#ff5cc8;--pu:#a78bfa;--r:18px}*{box-sizing:border-box;margin:0;padding:0}body,html{width:100%;height:100%;background:var(--bg);overflow:hidden}body{font-family:Inter,'Segoe UI',system-ui,sans-serif;color:var(--txt);-webkit-font-smoothing:antialiased;user-select:none}button{font-family:inherit;cursor:pointer;border:0;background:0 0;color:inherit}input{font-family:inherit}#stage{position:absolute;inset:0;overflow:hidden;background:var(--bg)}#app{position:absolute;left:0;top:0;width:1280px;height:720px;transform-origin:0 0;overflow:hidden;background:radial-gradient(900px 520px at 6% -12%,rgba(255,138,0,.17),transparent 62%),radial-gradient(760px 620px at 106% 18%,rgba(59,130,246,.15),transparent 60%),radial-gradient(700px 420px at 50% 125%,rgba(255,194,26,.08),transparent 62%),var(--bg)}#app::before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.55;background-image:radial-gradient(1px 1px at 12% 22%,#fff 50%,transparent 52%),radial-gradient(1px 1px at 33% 78%,#fff 50%,transparent 52%),radial-gradient(1.5px 1.5px at 58% 14%,#ffe9b8 50%,transparent 52%),radial-gradient(1px 1px at 72% 62%,#fff 50%,transparent 52%),radial-gradient(1px 1px at 88% 36%,#cfe0ff 50%,transparent 52%),radial-gradient(1px 1px at 46% 46%,#fff 50%,transparent 52%),radial-gradient(1.5px 1.5px at 92% 88%,#fff 50%,transparent 52%),radial-gradient(1px 1px at 22% 58%,#fff 50%,transparent 52%)}.brand{position:absolute;right:22px;top:10px;display:flex;align-items:center;gap:10px;z-index:5}.brand .t{font-family:Bangers,Impact,sans-serif;font-size:30px;letter-spacing:1.5px;line-height:1;background:linear-gradient(180deg,#ffe08a 0,#ffb21a 45%,#ff7a00 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 2px 0 rgba(0, 0, 0, .5))}.brand .s{font-size:9.5px;color:var(--sub);letter-spacing:.22em;text-transform:uppercase;font-weight:700;text-align:right}.brand .pg{font-family:Bangers,Impact,sans-serif;font-size:22px;letter-spacing:1.5px;color:var(--txt);opacity:.9;margin-right:6px}.card{position:absolute;background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:0 14px 34px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.05);overflow:hidden}.card>.hd{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 8px}.card h3{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#cfd7ea;display:flex;align-items:center;gap:8px}.card h3 .dot{width:7px;height:7px;border-radius:50%;background:var(--or);box-shadow:0 0 10px var(--or)}.card .aux{font-size"
			    & ":10.5px;color:var(--mut);font-weight:600}.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:10.5px;font-weight:700;background:rgba(148,163,209,.1);border:1px solid var(--line2);color:#d6ddee;white-space:nowrap}.src{display:inline-flex;align-items:center;gap:5px;padding:2px 7px;border-radius:6px;font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.src::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.src.c{color:var(--gr);background:rgba(57,255,136,.1)}.src.g{color:var(--or2);background:rgba(255,194,26,.1)}.src.e{color:#8fa3c8;background:rgba(143,163,200,.1)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 16px;border-radius:12px;font-size:12.5px;font-weight:800;background:rgba(148,163,209,.1);border:1px solid var(--line2);color:var(--txt);transition:transform .12s,background .2s,border-color .2s,opacity .2s}.btn:hover{background:rgba(148,163,209,.18);border-color:rgba(255,255,255,.3)}.btn:active{transform:scale(.97)}.btn:disabled{opacity:.35;pointer-events:none}.btn.pri{background:linear-gradient(180deg,#ffb02e,#ff7a00);border-color:#ffc46b;color:#1a1205;box-shadow:0 6px 22px rgba(255,122,0,.35)}.btn.pri:hover{filter:brightness(1.08)}.btn.on{background:rgba(255,138,0,.2);border-color:var(--or);color:#ffd8a8}.search{display:flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:11px;background:rgba(5,9,20,.55);border:1px solid var(--line2)}.search input{flex:1;background:0 0;border:0;outline:0;color:var(--txt);font-size:12.5px}.search input::placeholder{color:var(--mut)}.search svg{width:15px;height:15px;opacity:.6}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{padding:5px 11px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(148,163,209,.08);border:1px solid var(--line);color:var(--sub);transition:all .15s}.chip:hover{color:var(--txt);border-color:var(--line2)}.chip.on{background:var(--or);border-color:var(--or);color:#170d02}.scroll{overflow-y:auto;overflow-x:hidden}.scroll::-webkit-scrollbar{width:6px;height:6px}.scroll::-webkit-scrollbar-thumb{background:rgba(148,163,209,.25);border-radius:6px}.scroll::-webkit-scrollbar-track{background:0 0}.num{font-family:Rajdhani,'Segoe UI',sans-serif;font-weight:700;letter-spacing:.02em}.tit{font-family:Bangers,Impact,sans-serif;letter-spacing:1.2px;font-weight:400}.ret{position:relative;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}.ret img{height:100%;width:auto;max-width:none;object-fit:contain;filter:drop-shadow(0 8px 14px rgba(0, 0, 0, .5))}.ret svg.sil{height:100%;width:auto}.tip{position:absolute;pointer-events:none;z-index:60;background:rgba(8,12,24,.96);border:1px solid var(--line2);border-radius:10px;padding:8px 10px;font-size:11px;color:var(--txt);box-shadow:0 10px 24px rgba(0,0,0,.5);opacity:0;transition:opacity .12s;white-space:nowrap}.tip b{color:var(--or2)}@keyframes pulse{0%,"
			    & "100%{transform:scale(1);opacity:.85}50%{transform:scale(1.06);opacity:1}}@keyframes pop{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.12);opacity:1}100%{transform:scale(1)}}@keyframes fadeUp{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-9px)}40%{transform:translateX(8px)}60%{transform:translateX(-6px)}80%{transform:translateX(4px)}}@keyframes flick{0%,100%{opacity:1}45%{opacity:.55}50%{opacity:1}75%{opacity:.8}}.fade-up{animation:fadeUp .35s ease both}#placar{left:16px;top:60px;width:300px;height:644px;display:flex;flex-direction:column}#placar .big{padding:4px 18px 0}#placar .k{font-size:9px;font-weight:800;letter-spacing:.18em;color:var(--mut);text-transform:uppercase}#pts{font-size:54px;line-height:1;color:var(--or2)}.mini{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:12px 16px 0}.mini div{padding:9px 10px;border-radius:12px;background:rgba(5,9,20,.55);border:1px solid var(--line)}.mini b{display:block;font:700 21px Rajdhani,'Segoe UI',sans-serif;color:#fff}#prog{display:flex;gap:5px;padding:14px 16px 4px}#prog i{flex:1;height:7px;border-radius:4px;background:rgba(148,163,209,.14)}#prog i.ok{background:var(--gr);box-shadow:0 0 8px rgba(57,255,136,.5)}#prog i.er{background:var(--rd)}#prog i.at{background:var(--or);animation:flick 1s infinite}#escada{flex:1;padding:6px 12px 12px 16px}.pat{display:flex;align-items:center;gap:10px;height:44px;padding:0 10px;border-radius:11px;color:var(--mut);font-weight:700;font-size:12px}.pat .e{width:26px;display:grid;place-items:center}.pat .m{margin-left:auto;font:700 12px Rajdhani,'Segoe UI',sans-serif}.pat.on{background:rgba(255,138,0,.14);color:#fff;box-shadow:inset 0 0 0 1px rgba(255,138,0,.5)}#jogo{left:328px;top:60px;width:936px;height:644px}#topoQ{display:flex;align-items:center;gap:12px;padding:18px 24px 0}#nQ{font-size:12px;font-weight:800;letter-spacing:.14em;color:var(--sub);text-transform:uppercase}#cat{margin-left:4px}#rel{margin-left:auto;position:relative;width:52px;height:52px}#rel svg{transform:rotate(-90deg)}#rel span{position:absolute;inset:0;display:grid;place-items:center;font:700 18px Rajdhani,'Segoe UI',sans-serif}#txt{padding:14px 24px 0;font-size:25px;font-weight:800;line-height:1.25;min-height:98px}#txt small{display:block;font-size:13px;color:var(--sub);font-weight:600;margin-top:6px}#ops{padding:10px 24px 0;display:grid;gap:12px}#ops.duo{grid-template-columns:1fr 1fr}#ops.quad{grid-template-columns:1fr 1fr}.opc{position:relative;border-radius:16px;border:1px solid var(--line2);background:linear-gradient(180deg,rgba(30,41,72,.9),rgba(13,19,36,.95));cursor:pointer;overflow:hidden;transition:transform .12s,border-color .15s,box-shadow .15s;text-align:left}.opc:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.35)}.opc.ok{border-color:var(--gr);box-shadow:0 0 0 2px var(--gr),0 0 26px rgba(57,255,136,.3)}"
			    & ".opc.er{border-color:var(--rd);box-shadow:0 0 0 2px var(--rd);opacity:.8}.opc.off{pointer-events:none}.duo .opc{height:300px}.duo .opc .ret{position:absolute;left:0;right:0;top:10px;bottom:74px}.duo .opc .ret img,.duo .opc .ret svg{height:100%}.duo .opc .gl{position:absolute;left:50%;top:40%;width:260px;height:260px;margin:-130px 0 0 -130px;border-radius:50%;background:radial-gradient(circle,var(--aura),transparent 65%);opacity:.45}.duo .opc .rod{position:absolute;left:0;right:0;bottom:0;padding:12px 16px;background:linear-gradient(0deg,rgba(8,12,24,.97),rgba(8,12,24,.6))}.opc .n{font-size:26px;line-height:1}.opc .s{font-size:11.5px;color:var(--sub);margin-top:4px;font-weight:600}.quad .opc{height:112px;display:flex;align-items:center;gap:14px;padding:0 18px}.quad .opc .av{width:76px;height:92px;position:relative;flex:0 0 auto}.quad .opc .av .ret{position:absolute;inset:0;align-items:flex-start}.quad .opc .av img,.quad .opc .av svg{height:170%}.quad .opc .big{font:700 30px Rajdhani,'Segoe UI',sans-serif}.letra{position:absolute;right:12px;top:10px;width:26px;height:26px;border-radius:8px;display:grid;place-items:center;font-size:11px;font-weight:900;background:rgba(255,255,255,.08);color:var(--sub)}#fb{position:absolute;left:24px;right:24px;bottom:20px;min-height:86px;display:none;align-items:center;gap:16px;padding:14px 18px;border-radius:16px;background:rgba(5,9,20,.7);border:1px solid var(--line2)}#fb.on{display:flex;animation:fadeUp .3s both}#fb .ic{font-size:30px}#fb .t1{font-size:16px;font-weight:900}#fb .t2{font-size:12.5px;color:var(--sub);margin-top:3px;line-height:1.35}#fb .btn{margin-left:auto;flex:0 0 auto}.tela{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px}.tela.on{display:flex;animation:fadeUp .35s both}.tela h1{font-family:Bangers,Impact,sans-serif;font-size:64px;letter-spacing:2px;line-height:1;background:linear-gradient(180deg,#ffe08a,#ff7a00);-webkit-background-clip:text;background-clip:text;color:transparent}.tela p{color:var(--sub);font-size:14px;line-height:1.6;max-width:560px;margin:14px 0 24px}.tela .esf{display:flex;gap:8px;margin-bottom:18px}.tela .esf svg{animation:pop .5s both}.tela .btn.pri{height:50px;padding:0 34px;font-size:16px}#rankFinal{font-family:Bangers,Impact,sans-serif;font-size:46px;letter-spacing:1.5px;color:#fff;margin-top:6px}</style><div id=""stage""><div id=""app""><div class=""card"" id=""placar""><div class=""hd""><h3><span class=""dot""></span>Placar</h3><span class=""aux"" id=""rec""></span></div><div class=""big""><div class=""k"">Pontos</div><div id=""pts"" class=""num"">0</div></div><div class=""mini""><div><b id=""ac"">0/0</b><span class=""k"">acertos</span></div><div><b id=""seq"">0</b><span class=""k"">sequência</span></div><div><b id=""bon"">0</b><span class=""k"">bônus</span></div></div><div id=""prog""></div><div class=""hd"" style=""padding-top:12px""><h3><span class=""dot"" style=""background:var(--or2)""></span>Patentes</h3></div><div class=""scrol"
