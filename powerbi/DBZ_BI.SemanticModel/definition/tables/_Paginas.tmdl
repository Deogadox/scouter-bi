table _Paginas
	lineageTag: f9df7667-0b74-5c6c-9cc3-9e329962d516

	/// Sagas do Z em ordem cronológica: {o, n, a, e1, e2, f}.
	measure 'JSON Sagas' =
			VAR Q = UNICHAR ( 164 )
			VAR bruto =
			    CONCATENATEX (
			        dim_saga,
			        "{o:" & FORMAT ( dim_saga[ordem_cronologica], "0" )
			            & ",n:" & Q & dim_saga[nome] & Q
			            & ",a:" & Q & dim_saga[arco] & Q
			            & ",e1:" & FORMAT ( COALESCE ( dim_saga[episodio_inicio], 0 ), "0" )
			            & ",e2:" & FORMAT ( COALESCE ( dim_saga[episodio_fim], 0 ), "0" )
			            & ",f:" & IF ( dim_saga[filler], "1", "0" ) & "}",
			        ",",
			        dim_saga[ordem_cronologica], ASC
			    )
			VAR seguro =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        bruto, "\", "\\" ), "'", "\'" ), "<", "\u003c" ), UNICHAR ( 10 ), " " ), UNICHAR ( 13 ), "" )
			RETURN
			    "[" & SUBSTITUTE ( seguro, Q, "'" ) & "]"
		displayFolder: Dados (JSON)
		lineageTag: 0c4bb4d5-c349-5175-bb9f-508faf2c0436

	/// Personagens que têm leitura de poder: {id, n, r, af, pl, img, orig}.
	measure 'JSON Personagens' =
			VAR Q = UNICHAR ( 164 )
			VAR comPoder = FILTER ( dim_personagem, NOT ISEMPTY ( RELATEDTABLE ( fato_poder ) ) )
			VAR bruto =
			    CONCATENATEX (
			        comPoder,
			        "{id:" & FORMAT ( dim_personagem[sk_personagem], "0" )
			            & ",n:" & Q & TRIM ( dim_personagem[nome] ) & Q
			            & ",r:" & Q & dim_personagem[raca] & Q
			            & ",af:" & Q & dim_personagem[afiliacao] & Q
			            & ",pl:" & Q & TRIM ( RELATED ( dim_planeta[nome] ) ) & Q
			            & ",img:" & Q & dim_personagem[url_imagem] & Q
			            & ",orig:" & Q & dim_personagem[origem] & Q & "}",
			        ",",
			        dim_personagem[sk_personagem], ASC
			    )
			VAR seguro =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        bruto, "\", "\\" ), "'", "\'" ), "<", "\u003c" ), UNICHAR ( 10 ), " " ), UNICHAR ( 13 ), "" )
			RETURN
			    "[" & SUBSTITUTE ( seguro, Q, "'" ) & "]"
		displayFolder: Dados (JSON)
		lineageTag: 8fb77fcd-c0b2-5909-add0-d17e2e243da2

	/// Uma linha por personagem × saga × forma: {p, s, f, fi, v, src, ob}. s = ordem da saga.
	measure 'JSON Poder' =
			VAR Q = UNICHAR ( 164 )
			VAR bruto =
			    CONCATENATEX (
			        fato_poder,
			        "{p:" & FORMAT ( fato_poder[sk_personagem], "0" )
			            & ",s:" & FORMAT ( RELATED ( dim_saga[ordem_cronologica] ), "0" )
			            & ",f:" & Q & RELATED ( dim_transformacao[forma] ) & Q
			            & ",fi:" & Q & RELATED ( dim_transformacao[url_imagem] ) & Q
			            & ",v:" & FORMAT ( fato_poder[nivel_poder], "0" )
			            & ",src:" & Q & LOWER ( LEFT ( fato_poder[fonte_valor], 1 ) ) & Q
			            & ",ob:" & Q & fato_poder[observacao] & Q & "}",
			        ",",
			        fato_poder[sk_personagem], ASC,
			        fato_poder[sk_saga], ASC,
			        fato_poder[nivel_poder], ASC
			    )
			VAR seguro =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        bruto, "\", "\\" ), "'", "\'" ), "<", "\u003c" ), UNICHAR ( 10 ), " " ), UNICHAR ( 13 ), "" )
			RETURN
			    "[" & SUBSTITUTE ( seguro, Q, "'" ) & "]"
		displayFolder: Dados (JSON)
		lineageTag: 01163e87-21d3-5a2c-b7aa-d218a8740231

	/// Transformações da API que a curadoria não usa (galeria): {p, n, img}.
	measure 'JSON Transformações' =
			VAR Q = UNICHAR ( 164 )
			VAR bruto =
			    CONCATENATEX (
			        FILTER ( dim_transformacao, dim_transformacao[origem] = "api" ),
			        "{p:" & FORMAT ( dim_transformacao[sk_personagem], "0" )
			            & ",n:" & Q & TRIM ( dim_transformacao[forma] ) & Q
			            & ",img:" & Q & dim_transformacao[url_imagem] & Q & "}",
			        ",",
			        dim_transformacao[sk_personagem], ASC,
			        dim_transformacao[ordem], ASC
			    )
			VAR seguro =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        bruto, "\", "\\" ), "'", "\'" ), "<", "\u003c" ), UNICHAR ( 10 ), " " ), UNICHAR ( 13 ), "" )
			RETURN
			    "[" & SUBSTITUTE ( seguro, Q, "'" ) & "]"
		displayFolder: Dados (JSON)
		lineageTag: 1c232f02-f87b-5a8a-9b8a-7e54e815ee6f

	/// Lutas canônicas: {id, s, v, fv, d, fd, r, z, ob}. v/d = vencedor/perdedor, z = zebra.
	measure 'JSON Lutas' =
			VAR Q = UNICHAR ( 164 )
			VAR bruto =
			    CONCATENATEX (
			        fato_luta,
			        VAR fv = LOOKUPVALUE ( dim_transformacao[forma], dim_transformacao[sk_transformacao], fato_luta[sk_transformacao_vencedor] )
			        VAR fd = LOOKUPVALUE ( dim_transformacao[forma], dim_transformacao[sk_transformacao], fato_luta[sk_transformacao_perdedor] )
			        RETURN
			            "{id:" & FORMAT ( fato_luta[id_luta], "0" )
			                & ",s:" & FORMAT ( RELATED ( dim_saga[ordem_cronologica] ), "0" )
			                & ",v:" & FORMAT ( fato_luta[sk_vencedor], "0" )
			                & ",fv:" & Q & fv & Q
			                & ",d:" & FORMAT ( fato_luta[sk_perdedor], "0" )
			                & ",fd:" & Q & fd & Q
			                & ",r:" & Q & fato_luta[resultado] & Q
			                & ",z:" & IF ( fato_luta[zebra], "1", "0" )
			                & ",ob:" & Q & fato_luta[observacao] & Q & "}",
			        ",",
			        fato_luta[id_luta], ASC
			    )
			VAR seguro =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        bruto, "\", "\\" ), "'", "\'" ), "<", "\u003c" ), UNICHAR ( 10 ), " " ), UNICHAR ( 13 ), "" )
			RETURN
			    "[" & SUBSTITUTE ( seguro, Q, "'" ) & "]"
		displayFolder: Dados (JSON)
		lineageTag: f838056a-4d29-595c-a00f-70ba7a444181

	/// Contagens usadas na página Bastidores: {nApi, nExtra, nPl, nTr, nPod, ...}.
	measure 'JSON Meta' =
			"{"
			    & "nApi:" & FORMAT ( COUNTROWS ( FILTER ( dim_personagem, dim_personagem[origem] = "api" ) ) + 0, "0" )
			    & ",nExtra:" & FORMAT ( COUNTROWS ( FILTER ( dim_personagem, dim_personagem[origem] = "curadoria" ) ) + 0, "0" )
			    & ",nPl:" & FORMAT ( COUNTROWS ( dim_planeta ) + 0, "0" )
			    & ",nTr:" & FORMAT ( DISTINCTCOUNTNOBLANK ( dim_transformacao[id_api] ) + 0, "0" )
			    & ",nPod:" & FORMAT ( COUNTROWS ( fato_poder ) + 0, "0" )
			    & ",nCan:" & FORMAT ( COUNTROWS ( FILTER ( fato_poder, LEFT ( fato_poder[fonte_valor], 1 ) = "c" ) ) + 0, "0" )
			    & ",nGuia:" & FORMAT ( COUNTROWS ( FILTER ( fato_poder, LEFT ( fato_poder[fonte_valor], 1 ) = "g" ) ) + 0, "0" )
			    & ",nEst:" & FORMAT ( COUNTROWS ( FILTER ( fato_poder, LEFT ( fato_poder[fonte_valor], 1 ) = "e" ) ) + 0, "0" )
			    & ",nLut:" & FORMAT ( COUNTROWS ( fato_luta ) + 0, "0" )
			    & ",nZeb:" & FORMAT ( COUNTROWS ( FILTER ( fato_luta, fato_luta[zebra] ) ) + 0, "0" )
			    & ",nVit:" & FORMAT ( COUNTROWS ( FILTER ( fato_luta, fato_luta[resultado] = "vitoria" ) ) + 0, "0" )
			    & ",kiDesc:" & FORMAT ( COUNTROWS ( FILTER ( dim_personagem, dim_personagem[origem] = "api" && dim_personagem[ki_max_api_status] = "desconhecido" ) ) + 0, "0" )
			    & ",kiInc:" & FORMAT ( COUNTROWS ( FILTER ( dim_personagem, dim_personagem[origem] = "api" && dim_personagem[ki_max_api_status] = "incomensuravel" ) ) + 0, "0" )
			    & ",nSagas:" & FORMAT ( COUNTROWS ( dim_saga ) + 0, "0" )
			    & "}"
		displayFolder: Dados (JSON)
		lineageTag: 1021b32d-fb2f-5844-8929-db4af570c3e6

	/// Objeto único com todo o modelo, injetado em cada página HTML como window.D.
	measure 'JSON Dados' =
			"{sagas:" & [JSON Sagas]
			    & ",per:" & [JSON Personagens]
			    & ",pod:" & [JSON Poder]
			    & ",tra:" & [JSON Transformações]
			    & ",lut:" & [JSON Lutas]
			    & ",meta:" & [JSON Meta] & "}"
		displayFolder: Dados (JSON)
		lineageTag: 2da97138-bceb-5f57-9b72-4a28aadd193b

	/// Página Scouter: Ficha de cada guerreiro: leitura do scouter por saga e forma, evolução e lutas. HTML/CSS/JS minificados (fonte em powerbi/html).
	measure 'HTML Scouter' =
			VAR dados = [JSON Dados]
			RETURN
			    "<style>@import url(https://fonts.googleapis.com/css2?family=Bangers&family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700;800;900&display=swap);:root{--bg:#070b16;--card:rgba(16, 23, 42, .82);--card2:rgba(25, 34, 60, .9);--line:rgba(148, 163, 209, .12);--line2:rgba(148, 163, 209, .24);--txt:#eef2fa;--sub:#9aa6c4;--mut:#5f6b8a;--or:#ff8a00;--or2:#ffc21a;--gr:#39ff88;--bl:#3b82f6;--bl2:#60a5fa;--rd:#ff4d5e;--pk:#ff5cc8;--pu:#a78bfa;--r:18px}*{box-sizing:border-box;margin:0;padding:0}body,html{width:100%;height:100%;background:var(--bg);overflow:hidden}body{font-family:Inter,'Segoe UI',system-ui,sans-serif;color:var(--txt);-webkit-font-smoothing:antialiased;user-select:none}button{font-family:inherit;cursor:pointer;border:0;background:0 0;color:inherit}input{font-family:inherit}#stage{position:absolute;inset:0;overflow:hidden;background:var(--bg)}#app{position:absolute;left:0;top:0;width:1280px;height:720px;transform-origin:0 0;overflow:hidden;background:radial-gradient(900px 520px at 6% -12%,rgba(255,138,0,.17),transparent 62%),radial-gradient(760px 620px at 106% 18%,rgba(59,130,246,.15),transparent 60%),radial-gradient(700px 420px at 50% 125%,rgba(255,194,26,.08),transparent 62%),var(--bg)}#app::before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.55;background-image:radial-gradient(1px 1px at 12% 22%,#fff 50%,transparent 52%),radial-gradient(1px 1px at 33% 78%,#fff 50%,transparent 52%),radial-gradient(1.5px 1.5px at 58% 14%,#ffe9b8 50%,transparent 52%),radial-gradient(1px 1px at 72% 62%,#fff 50%,transparent 52%),radial-gradient(1px 1px at 88% 36%,#cfe0ff 50%,transparent 52%),radial-gradient(1px 1px at 46% 46%,#fff 50%,transparent 52%),radial-gradient(1.5px 1.5px at 92% 88%,#fff 50%,transparent 52%),radial-gradient(1px 1px at 22% 58%,#fff 50%,transparent 52%)}.brand{position:absolute;right:22px;top:10px;display:flex;align-items:center;gap:10px;z-index:5}.brand .t{font-family:Bangers,Impact,sans-serif;font-size:30px;letter-spacing:1.5px;line-height:1;background:linear-gradient(180deg,#ffe08a 0,#ffb21a 45%,#ff7a00 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 2px 0 rgba(0, 0, 0, .5))}.brand .s{font-size:9.5px;color:var(--sub);letter-spacing:.22em;text-transform:uppercase;font-weight:700;text-align:right}.brand .pg{font-family:Bangers,Impact,sans-serif;font-size:22px;letter-spacing:1.5px;color:var(--txt);opacity:.9;margin-right:6px}.card{position:absolute;background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:0 14px 34px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.05);overflow:hidden}.card>.hd{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 8px}.card h3{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#cfd7ea;display:flex;align-items:center;gap:8px}.card h3 .dot{width:7px;height:7px;border-radius:50%;background:var(--or);box-shadow:0 0 10px var(--or)}.card .aux{font-size"
			    & ":10.5px;color:var(--mut);font-weight:600}.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:10.5px;font-weight:700;background:rgba(148,163,209,.1);border:1px solid var(--line2);color:#d6ddee;white-space:nowrap}.src{display:inline-flex;align-items:center;gap:5px;padding:2px 7px;border-radius:6px;font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.src::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.src.c{color:var(--gr);background:rgba(57,255,136,.1)}.src.g{color:var(--or2);background:rgba(255,194,26,.1)}.src.e{color:#8fa3c8;background:rgba(143,163,200,.1)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 16px;border-radius:12px;font-size:12.5px;font-weight:800;background:rgba(148,163,209,.1);border:1px solid var(--line2);color:var(--txt);transition:transform .12s,background .2s,border-color .2s,opacity .2s}.btn:hover{background:rgba(148,163,209,.18);border-color:rgba(255,255,255,.3)}.btn:active{transform:scale(.97)}.btn:disabled{opacity:.35;pointer-events:none}.btn.pri{background:linear-gradient(180deg,#ffb02e,#ff7a00);border-color:#ffc46b;color:#1a1205;box-shadow:0 6px 22px rgba(255,122,0,.35)}.btn.pri:hover{filter:brightness(1.08)}.btn.on{background:rgba(255,138,0,.2);border-color:var(--or);color:#ffd8a8}.search{display:flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:11px;background:rgba(5,9,20,.55);border:1px solid var(--line2)}.search input{flex:1;background:0 0;border:0;outline:0;color:var(--txt);font-size:12.5px}.search input::placeholder{color:var(--mut)}.search svg{width:15px;height:15px;opacity:.6}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{padding:5px 11px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(148,163,209,.08);border:1px solid var(--line);color:var(--sub);transition:all .15s}.chip:hover{color:var(--txt);border-color:var(--line2)}.chip.on{background:var(--or);border-color:var(--or);color:#170d02}.scroll{overflow-y:auto;overflow-x:hidden}.scroll::-webkit-scrollbar{width:6px;height:6px}.scroll::-webkit-scrollbar-thumb{background:rgba(148,163,209,.25);border-radius:6px}.scroll::-webkit-scrollbar-track{background:0 0}.num{font-family:Rajdhani,'Segoe UI',sans-serif;font-weight:700;letter-spacing:.02em}.tit{font-family:Bangers,Impact,sans-serif;letter-spacing:1.2px;font-weight:400}.ret{position:relative;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}.ret img{height:100%;width:auto;max-width:none;object-fit:contain;filter:drop-shadow(0 8px 14px rgba(0, 0, 0, .5))}.ret svg.sil{height:100%;width:auto}.tip{position:absolute;pointer-events:none;z-index:60;background:rgba(8,12,24,.96);border:1px solid var(--line2);border-radius:10px;padding:8px 10px;font-size:11px;color:var(--txt);box-shadow:0 10px 24px rgba(0,0,0,.5);opacity:0;transition:opacity .12s;white-space:nowrap}.tip b{color:var(--or2)}@keyframes pulse{0%,"
			    & "100%{transform:scale(1);opacity:.85}50%{transform:scale(1.06);opacity:1}}@keyframes pop{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.12);opacity:1}100%{transform:scale(1)}}@keyframes fadeUp{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-9px)}40%{transform:translateX(8px)}60%{transform:translateX(-6px)}80%{transform:translateX(4px)}}@keyframes flick{0%,100%{opacity:1}45%{opacity:.55}50%{opacity:1}75%{opacity:.8}}.fade-up{animation:fadeUp .35s ease both}#lista{left:16px;top:60px;width:300px;height:644px;display:flex;flex-direction:column}#lista .ctl{padding:0 14px 10px;display:flex;flex-direction:column;gap:9px}#grade{flex:1;padding:2px 10px 14px 14px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;align-content:start}.tile{position:relative;height:112px;border-radius:13px;overflow:hidden;cursor:pointer;background:linear-gradient(180deg,rgba(32,44,78,.92),rgba(13,19,36,.96));border:1px solid var(--line);transition:transform .15s,border-color .15s,box-shadow .15s}.tile:hover{transform:translateY(-2px);border-color:var(--line2)}.tile.on{border-color:var(--or);box-shadow:0 0 0 1px var(--or),0 8px 22px rgba(255,138,0,.28)}.tile .glow{position:absolute;left:50%;top:42%;width:74px;height:74px;transform:translate(-50%,-50%);border-radius:50%;filter:blur(16px);opacity:.32}.tile .ret{position:absolute;left:0;right:0;top:6px;bottom:22px;align-items:flex-start}.tile .ret img,.tile .ret svg{height:230%}.tile .nm{position:absolute;left:4px;right:4px;bottom:6px;text-align:center;font-size:10.5px;font-weight:800;color:#e3e9f6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 1px 2px #000}.tile .fx{position:absolute;left:0;right:0;bottom:0;height:34px;background:linear-gradient(0deg,rgba(8,12,24,.95),transparent)}#hero{left:328px;top:60px;width:524px;height:644px}#hero .bg{position:absolute;inset:0;opacity:.5;background:radial-gradient(360px 300px at 50% 46%,var(--aura,#7fb2ff),transparent 70%);transition:background .5s;filter:saturate(1.2)}#hero .bg2{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,14,28,.55),rgba(10,14,28,.1) 30%,rgba(10,14,28,.78) 72%)}#hero .idn{position:absolute;left:20px;top:16px;font-size:22px;color:rgba(255,255,255,.22)}#hero .orig{position:absolute;right:18px;top:16px}#hero .nome{position:absolute;left:0;right:0;top:30px;text-align:center;font-size:56px;line-height:1;color:#fff;text-shadow:0 3px 0 rgba(0,0,0,.45),0 0 26px var(--aura,#7fb2ff)}#hero .pills{position:absolute;left:0;right:0;top:92px;display:flex;justify-content:center;gap:7px}#palco{position:absolute;left:0;right:0;top:118px;height:300px}#palco .halo{position:absolute;left:50%;top:52%;width:290px;height:290px;margin:-145px 0 0 -145px;border-radius:50%;background:radial-gradient(circle,var(--aura,#7fb2ff) 0,transparent 66%);opacity:.55;animation:pulse 2.2s ease-in-out infinite"
