	partition fato_poder = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema="dw",Item="fato_poder"]}[Data]
				in
				    Dados

	annotation PBI_ResultType = Table

