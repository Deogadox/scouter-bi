table 'Lutador A'
	lineageTag: 3bc8acc3-56c0-5f7a-9910-9bd655658234

	/// Poder do lutador escolhido no lado A.
	measure 'Poder A' = MAX ( 'Lutador A'[Poder] )
		formatString: #,0
		displayFolder: Simulador
		lineageTag: 73069c21-05b2-5aec-bcd0-0aa6aaa0d3b5

	/// Poder do lutador escolhido no lado B.
	measure 'Poder B' = MAX ( 'Lutador B'[Poder] )
		formatString: #,0
		displayFolder: Simulador
		lineageTag: a7460a1a-04ed-52e6-b739-58f6a19d45c1

	/// Modelo Elo simplificado: chance = A² / (A² + B²). Poder 2x maior dá 80%.
	measure 'Chance de Vitória A' =
			VAR la = MAX ( 'Lutador A'[Log] )
			VAR lb = MAX ( 'Lutador B'[Log] )
			RETURN
			    IF (
			        ISBLANK ( la ) || ISBLANK ( lb ),
			        BLANK (),
			        1 / ( 1 + POWER ( 10, -2 * ( la - lb ) ) )
			    )
		formatString: 0%
		displayFolder: Simulador
		lineageTag: 927fee67-313c-532d-90fc-b47a6a377d8d

	/// Complemento da chance de A.
	measure 'Chance de Vitória B' = IF ( ISBLANK ( [Chance de Vitória A] ), BLANK (), 1 - [Chance de Vitória A] )
		formatString: 0%
		displayFolder: Simulador
		lineageTag: 1cd20487-9214-5838-89db-fb88dc54ed07

	/// Frase do resultado do simulador.
	measure Veredito =
			VAR a = SELECTEDVALUE ( 'Lutador A'[Personagem] )
			VAR b = SELECTEDVALUE ( 'Lutador B'[Personagem] )
			VAR p = [Chance de Vitória A]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( p ), "Escolha os dois lutadores",
			        p >= 0.95, a & " vence com folga",
			        p > 0.55, a & " é favorito",
			        p >= 0.45, "Luta equilibrada",
			        p > 0.05, b & " é favorito",
			        b & " vence com folga"
			    )
		displayFolder: Simulador
		lineageTag: bcb1b5a5-c9f2-50ca-a23c-52c0b4c46334

